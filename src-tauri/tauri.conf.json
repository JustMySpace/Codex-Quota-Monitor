{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Quota Monitor",
  "version": "0.1.0",
  "identifier": "com.showm.codexquotamonitor",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "float",
        "title": "Codex Token Float",
        "width": 304,
        "height": 136,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "shadow": true
      },
      {
        "label": "panel",
        "title": "Codex Quota Monitor",
        "width": 1040,
        "height": 760,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
